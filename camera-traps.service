[Unit]
Description=ViumbeLens Camera Trap Auto-Analyzer FastAPI Service
After=network.target

[Service]
Type=simple
User=mutuma
WorkingDirectory=/media/mutuma/0BF506A40BF506A4/camera-traps
ExecStart=/media/mutuma/0BF506A40BF506A4/camera-traps/venv/bin/python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=DB_PATH=/media/mutuma/0BF506A40BF506A4/camera-traps/wildlife_data.db

[Install]
WantedBy=multi-user.target

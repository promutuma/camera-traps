# Copy this file to .env and adjust values for your environment.
# All variables have safe defaults built into the code, so .env is optional.

# Path to the SQLite database file (absolute or relative to working directory)
DB_PATH=wildlife_data.db

# Comma-separated list of origins the CORS middleware will allow.
# Add your frontend URL here if it runs on a different host/port.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum size (in MB) accepted for a single uploaded image file.
MAX_UPLOAD_MB=50

# How many hours a completed/failed job stays in memory before being evicted.
# Temp directories for those jobs are deleted at the same time.
JOB_TTL_HOURS=2

# Secret for signing username-only session cookies (change in production).
SESSION_SECRET=change-me-in-production

# SpeciesNet model download (free Kaggle account — https://www.kaggle.com/settings/account)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Docker build (optional — ./compose.sh sets these automatically)
# DOCKER_BUILDKIT=1
# COMPOSE_DOCKER_CLI_BUILD=1
# BUILDX_NO_DEFAULT_ATTESTATIONS=1
